<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ExerciseDetailActivity"
    android:background="#242424">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="55dp"
        android:paddingTop="25dp"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/exercise_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textAlignment="viewStart"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:text="Exercise name"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/max_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#355CFF"
                android:textSize="18sp"
                android:text="Max weight:"
                android:paddingStart="20dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/max_weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:text="100 kg"
                android:paddingHorizontal="20dp" />
        </LinearLayout>


        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/max_weight_chart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginHorizontal="5dp"
            android:layout_marginBottom="25dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/max_set_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#355CFF"
                android:textSize="18sp"
                android:text="Max set volume:"
                android:paddingStart="20dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/max_set_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:text="100 kg"
                android:paddingHorizontal="20dp" />
        </LinearLayout>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/best_set_chart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginHorizontal="5dp"
            android:layout_marginBottom="25dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/max_session_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#355CFF"
                android:textSize="18sp"
                android:text="Max session volume:"
                android:paddingStart="20dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/max_session_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:text="100 kg"
                android:paddingHorizontal="20dp" />
        </LinearLayout>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/session_volume_chart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginHorizontal="5dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>